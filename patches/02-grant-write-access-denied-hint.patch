+/** ERROR_ACCESS_DENIED (winerror.h): the caller lacks WRITE_DAC on the directory. */
+const ERROR_ACCESS_DENIED = 5;
+/**
+* Hint appended when SetNamedSecurityInfoW returns ERROR_ACCESS_DENIED:
+* modifying a directory's DACL requires WRITE_DAC, which the current user
+* only holds implicitly when they OWN the directory (or via an explicit ACE).
+* Directories migrated from another Windows install (or another account) keep
+* their foreign owner, so this fails for every grant attempt on them.
+*/
+const DACL_ACCESS_DENIED_HINT = "; the current user lacks WRITE_DAC (the directory's owner is not the current account). Fix once: open an admin terminal and run `icacls <dir> /setowner <current-user> /T /C` (e.g. `icacls C:\\workspace /setowner $env:USERNAME /T /C`) to take ownership, then retry";
