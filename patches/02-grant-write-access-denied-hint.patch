 	const applyResult = api.setNamedSecurityInfoW(path, 1, 4, null, null, newAcl, null);
 	const freedNew = api.localFree(newAcl);
-	if (applyResult !== 0) throwWin32(api, "SetNamedSecurityInfoW", applyResult, `${label}(${path})`);
